generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Seller {
  id             Int             @id @default(autoincrement()) @map("Id")
  sellerName     String          @unique @map("SellerName")
  createdAt      DateTime        @default(now()) @map("CreatedAt")
  updatedAt      DateTime        @updatedAt @map("UpdatedAt")
  sellerProducts SellerProduct[]

  @@map("Seller")
}

model NormalizationType {
  id               Int       @id @default(autoincrement()) @map("Id")
  code             String    @unique @map("Code")
  description      String    @map("Description")
  includesBrand    Boolean   @map("IncludesBrand")
  includesCategory Boolean   @map("IncludesCategory")
  createdAt        DateTime  @default(now()) @map("CreatedAt")
  updatedAt        DateTime  @updatedAt @map("UpdatedAt")
  products         Product[]

  @@map("NormalizationType")
}

model Product {
  id                  Int               @id @default(autoincrement()) @map("Id")
  name                String            @map("Name")
  brand               String?           @map("Brand")
  category            String?           @map("Category")
  normalizationTypeId Int               @map("NormalizationTypeId")
  normalizedKey       String            @map("NormalizedKey")
  createdAt           DateTime          @default(now()) @map("CreatedAt")
  updatedAt           DateTime          @updatedAt @map("UpdatedAt")
  normalizationType   NormalizationType @relation(fields: [normalizationTypeId], references: [id])
  sellerProducts      SellerProduct[]

  @@unique([normalizationTypeId, normalizedKey])
  @@index([normalizedKey])
  @@map("Product")
}

model SellerProduct {
  id         Int      @id @default(autoincrement()) @map("Id")
  productId  Int      @map("ProductId")
  sellerId   Int      @map("SellerId")
  externalId String?  @map("ExternalId")
  name       String   @map("Name")
  brand      String?  @map("Brand")
  category   String?  @map("Category")
  matchedBy  String   @map("MatchedBy")
  createdAt  DateTime @default(now()) @map("CreatedAt")
  updatedAt  DateTime @updatedAt @map("UpdatedAt")
  product    Product  @relation(fields: [productId], references: [id])
  seller     Seller   @relation(fields: [sellerId], references: [id])

  @@unique([productId, sellerId])
  @@unique([sellerId, externalId])
  @@map("SellerProduct")
}
